# Supabase — required by all scripts
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Postgres direct URL — required by db-backup only
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# AI keys — required by daily-data-pipeline (insights step) and price-movement-summary
# Use at least one of DeepSeek (cheaper) or OpenAI
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Backup repo — required by db-backup only
BACKUP_REPO=MaxNervoAI/finixhub-backups
BACKUP_REPO_TOKEN=github_pat_...
